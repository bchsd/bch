doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title Bridges Community House

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        // Bootstrap icons
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css', rel='stylesheet', type='text/css')

        // Google fonts
        link(href='https://fonts.googleapis.com/css?family=Fredoka:300,400,700,300italic,400italic,700italic', rel='stylesheet', type='text/css')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body

        // Navigation
        nav.navbar.navbar-light.bg-light.sticky-top
            .container
                a.navbar-brand(href='#')
                    img(src='assets/favicon.ico', alt='Logo', height='50', class='d-inline-block align-middle mr-2')
                    span.fs-3.align-middle.text-primary Bridges Community House
                // Hamburger Menu Button (Visible on mobile)
                button.navbar-toggler.border-primary.text-primary(type='button', data-bs-toggle='collapse', data-bs-target='#navbarNav', aria-controls='navbarNav', aria-expanded='false', aria-label='Toggle navigation')
                    span.navbar-toggler-icon.text-primary
        
                // Collapsible Menu Content
                #navbarNav.collapse.navbar-collapse.justify-content-center
                    ul.navbar-nav.align-items-center
                        li.nav-item
                            a.nav-link.text-primary.link-primary(href='#about') About Us
                        li.nav-item
                            a.nav-link.text-primary.link-primary(href='#services') Services
                        li.nav-item
                            a.nav-link.text-primary.link-primary(href='#contactus') Contact Us

        // Masthead
        header.masthead.position-relative
            // Carousel background
            .carousel.slide#mastheadCarousel(data-bs-ride='carousel')
                .carousel-inner
                    .carousel-item.active
                        img(src='/assets/img/main-showcase-1.jpg', alt='Slide 1')
                    .carousel-item
                        img(src='/assets/img/main-showcase-2.jpg', alt='Slide 2')
                    .carousel-item
                        img(src='/assets/img/main-showcase-3.jpg', alt='Slide 3')
                    .carousel-item
                        img(src='/assets/img/main-showcase-4.jpg', alt='Slide 4')
                    .carousel-item
                        img(src='/assets/img/main-showcase-5.jpg', alt='Slide 5')                                    
            // Text overlay
            .position-absolute.top-50.start-50.translate-middle.text-center.text-white
                h1.display-2 Belonging, Community, Hope
                p.lead Empowering Adults, Enriching Lives

        // About Us Section
        section#about.py-5.bg-white
            .container
                // Section Title
                .row.mb-5
                    .col-12.text-center
                        h2.fw-bold.mb-2 ABOUT US
                        p.text-muted.text-uppercase.tracking-wider Who We Are &amp; What We Stand For

                .row.g-4.align-items-stretch
                    // Left Column: Core Mission Card
                    .col-md-6
                        .card.h-100.border-0.bg-light.shadow-sm.p-4.p-lg-5
                            .card-body.d-flex.flex-column.justify-content-center
                                span.text-primary.fs-1.mb-3
                                    i.bi.bi-quote
                                h3.h4.fw-bold.text-primary.mb-3 Our Mission
                                p.card-text.fs-5.text-dark.lh-base
                                    | To support adults (18+) facing mental health challenges by creating welcoming, 
                                    | community-based spaces where people can connect, learn practical life skills, 
                                    | and feel supported in their everyday lives. 
                                p.card-text.text-muted.mb-0
                                    | We focus on building genuine relationships, reducing isolation, and 
                                    | helping individuals grow with confidence and stability.

                    // Right Column: Diversity & Community Commitment
                    .col-md-6.d-flex.flex-column.justify-content-center.p-4.p-lg-5
                        h3.h4.fw-bold.text-dark.mb-4 Our Commitment to Diversity
                        p.text-secondary.fs-6.lh-lg.mb-4
                            | We are committed to serving diverse communities, including immigrants and refugees, 
                            | by offering programs that respect cultural and language needs.
                        
                        // Key pillars broken into a micro-list for better scannability
                        .d-flex.align-items-start.mb-3
                            .badge.bg-primary-subtle.text-primary.rounded-circle.p-2.me-3
                                i.bi.bi-people-fill
                            div
                                h5.fs-6.fw-bold.mb-1 Community Partnerships
                                p.text-muted.small.mb-0 Collaborating locally to expand access to meaningful connections.
                        
                        .d-flex.align-items-start
                            .badge.bg-primary-subtle.text-primary.rounded-circle.p-2.me-3
                                i.bi.bi-heart-fill
                            div
                                h5.fs-6.fw-bold.mb-1 Inclusive Spaces
                                p.text-muted.small.mb-0 Ensuring everyone has a safe, supportive place to belong and thrive.

        // Icons Grid
        section#services.features-icons.bg-light.text-center
            .container
                .row.mb-2
                    .col-lg-4.mx-auto
                        h1 Our Services
                        p.lead.mb-0 Programs that help individuals build skills, confidence, and belonging.
                .row
                    .col-md-6.col-lg-2
                        .features-icons-item.mx-auto.mb-5.mb-lg-0.mb-lg-3
                            .features-icons-icon.d-flex
                                i.bi-people.m-auto.text-primary
                            h3 Social Connection
                            p.lead.mb-0 Build friendships and connect.

                    .col-md-6.col-lg-2
                        .features-icons-item.mx-auto.mb-5.mb-lg-0.mb-lg-3
                            .features-icons-icon.d-flex
                                i.bi-translate.m-auto.text-primary
                            h3 ESL Classes
                            p.lead.mb-0 Learn English at your own pace.

                    .col-md-6.col-lg-2
                        .features-icons-item.mx-auto.mb-5.mb-lg-0.mb-lg-3
                            .features-icons-icon.d-flex
                                i.bi-patch-check.m-auto.text-primary
                            h3 Citizenship
                            p.lead.mb-0 Get help preparing to apply.

                    .col-md-6.col-lg-2
                        .features-icons-item.mx-auto.mb-5.mb-lg-0.mb-lg-3
                            .features-icons-icon.d-flex
                                i.bi-briefcase.m-auto.text-primary
                            h3 Employment
                            p.lead.mb-0 Build skills and find work.

                    .col-md-6.col-lg-2
                        .features-icons-item.mx-auto.mb-5.mb-lg-0.mb-lg-3
                            .features-icons-icon.d-flex
                                i.bi-egg-fried.m-auto.text-primary
                            h3 Cooking
                            p.lead.mb-0 Cook, share, and learn together.

                    .col-md-6.col-lg-2
                        .features-icons-item.mx-auto.mb-0.mb-lg-3
                            .features-icons-icon.d-flex
                                i.bi-laptop.m-auto.text-primary
                            h3 Digital Skills
                            p.lead.mb-0 Learn computers and online tools.

        // Image Showcases
        section.showcase
            .container-fluid.p-0
                .row.g-0
                    .col-lg-6.order-lg-2.text-white.showcase-img(style="background-image: url('assets/img/main-showcase-1.jpg');")
                    .col-lg-6.order-lg-1.my-auto.showcase-text
                        h2 Social Connection
                        p.lead.mb-0
                            | Build friendships, reduce isolation, and strengthen community through peer mentorship, intergenerational activities, and meaningful social engagement.

                .row.g-0
                    .col-lg-6.text-white.showcase-img(style="background-image: url('assets/img/main-showcase-2.jpg');")
                    .col-lg-6.my-auto.showcase-text
                        h2 ESL Classes
                        p.lead.mb-0
                            | Learn English through beginner, intermediate, and conversation-focused classes designed to support participants at different language levels.

                .row.g-0
                    .col-lg-6.order-lg-2.text-white.showcase-img(style="background-image: url('assets/img/main-showcase-3.jpg');")
                    .col-lg-6.order-lg-1.my-auto.showcase-text
                        h2 Citizenship Support
                        p.lead.mb-0
                            | Receive personalized guidance and small-group support to prepare for the citizenship process with confidence.

                .row.g-0
                    .col-lg-6.text-white.showcase-img(style="background-image: url('assets/img/main-showcase-4.jpg');")
                    .col-lg-6.my-auto.showcase-text
                        h2 Employment Support
                        p.lead.mb-0
                            | Develop job-ready skills through computer training, online applications, workplace communication, resume writing, and interview preparation.

                .row.g-0
                    .col-lg-6.order-lg-2.text-white.showcase-img(style="background-image: url('assets/img/main-showcase-5.jpg');")
                    .col-lg-6.order-lg-1.my-auto.showcase-text
                        h2 Cooking & Life Skills
                        p.lead.mb-0
                            | Share practical knowledge, learn everyday skills, and connect across generations through hands-on cooking and community activities.
                .row.g-0
                    .col-lg-6.text-white.showcase-img(style="background-image: url('assets/img/main-showcase-3.jpg');")
                    .col-lg-6.my-auto.showcase-text
                        h2 Digital Skills
                        p.lead.mb-0
                            | Learn to use computers, smartphones, email, and online services with confidence for everyday life and work.

        // Testimonials
        section.testimonials.text-center.bg-light
            .container
                h2.mb-5 What people are saying...
                .row
                    .col-lg-4
                        .testimonial-item.mx-auto.mb-5.mb-lg-0
                            img.img-fluid.rounded-circle.mb-3(src='assets/img/testimonials-1.jpg', alt='...')
                            h5 Margaret E.
                            p.font-weight-light.mb-0 "This is fantastic! Thanks so much guys!"
                    .col-lg-4
                        .testimonial-item.mx-auto.mb-5.mb-lg-0
                            img.img-fluid.rounded-circle.mb-3(src='assets/img/testimonials-2.jpg', alt='...')
                            h5 Fred S.
                            p.font-weight-light.mb-0
                                | "Bootstrap is amazing. I've been using it to create lots of super nice landing pages."
                    .col-lg-4
                        .testimonial-item.mx-auto.mb-5.mb-lg-0
                            img.img-fluid.rounded-circle.mb-3(src='assets/img/testimonials-3.jpg', alt='...')
                            h5 Sarah W.
                            p.font-weight-light.mb-0 "Thanks so much for making these free resources available to us!"

        // Schedule Section
        section#schedule.py-5.bg-white
            .container
                .row.justify-content-center
                    .col-lg-8.text-center
                        // Section Heading
                        h2.mb-4.text-center.fw-bold DAILY SCHEDULE (ADJUSTED FOR MIXED AGES)
                        span.badge.bg-primary.px-3.py-2.fs-6 Monday – Friday, 9 AM – 5 PM PST

                        // Schedule List Container
                        .list-group.shadow-sm.pt-2
                            
                            // Item 1
                            .list-group-item.p-3
                                .d-flex.flex-column.flex-md-row
                                    span.fw-bold.text-primary.me-4.min-w-150 9:00 – 9:30 AM
                                    div Open social time (all participants)
                            
                            // Item 2
                            .list-group-item.p-3
                                .d-flex.flex-column.flex-md-row
                                    span.fw-bold.text-primary.me-4.min-w-150 9:30 – 10:30 AM
                                    div ESL / Citizenship (grouped by level)
                            
                            // Item 3 (Break)
                            .list-group-item.p-3.bg-light
                                .d-flex.flex-column.flex-md-row
                                    span.fw-bold.text-muted.me-4.min-w-150 10:30 – 11:00 AM
                                    div.text-muted.fst-italic Break
                            
                            // Item 4 (Nested Breakouts)
                            .list-group-item.p-3
                                .d-flex.flex-column.flex-md-row
                                    span.fw-bold.text-primary.me-4.min-w-150 11:00 – 12:00 PM
                                    div
                                        .fw-bold Breakout sessions:
                                        ul.list-unstyled.ms-3.mt-2.mb-0
                                            li.mb-1
                                                i.bi.bi-arrow-right-short.text-primary.me-1
                                                | Employment support (younger adults)
                                            li
                                                i.bi.bi-arrow-right-short.text-primary.me-1
                                                | Social/wellness group (older adults)
                            
                            // Item 5
                            .list-group-item.p-3
                                .d-flex.flex-column.flex-md-row
                                    span.fw-bold.text-primary.me-4.min-w-150 12:00 – 1:00 PM
                                    div Cooking &amp; shared meal (all together)
                            
                            // Item 6
                            .list-group-item.p-3
                                .d-flex.flex-column.flex-md-row
                                    span.fw-bold.text-primary.me-4.min-w-150 1:00 – 2:00 PM
                                    div Flexible activities (mixed or grouped)

        // Call to Action
        section#contactus.call-to-action.bg-light.text-white.text-center
            .container.position-relative
                .row.justify-content-center
                    .col-xl-6
                        h2.mb-4 Have questions or need support?
                        p.mb-4 We’re here to help Monday – Friday, 9 AM – 5 PM PST.

                        // Contact Email
                        p.mb-2
                            strong Email:
                            a.text-white.ms-2(href='mailto:bridgescommunityhouse@gmail.com')
                                | bridgescommunityhouse@gmail.com

                        // Phone Number
                        p.mb-2
                            strong Phone:
                            a.text-white.ms-2(href='tel:+18583308172')
                                | (858) 330-8172

                        // Physical Address
                        p.mb-4
                            strong Address:
                            |  9504 Carroll Canyon Rd, San Diego, CA 92126

                        // Email button
                        a.btn.btn-primary(href='mailto:bridgescommunityhouse@gmail.com')
                            | Email


        // Footer
        footer.footer.bg-light
            .container
                .row
                    .col-lg-6.h-100.text-center.text-lg-start.my-auto
                        ul.list-inline.mb-2
                            li.list-inline-item
                                a(href='#!') About
                            li.list-inline-item ⋅
                            li.list-inline-item
                                a(href='#!') Contact
                            li.list-inline-item ⋅
                            li.list-inline-item
                                a(href='#!') Terms of Use
                            li.list-inline-item ⋅
                            li.list-inline-item
                                a(href='#!') Privacy Policy
                        p.text-muted.small.mb-4.mb-lg-0 &copy; Your Website 2023. All Rights Reserved.
                    .col-lg-6.h-100.text-center.text-lg-end.my-auto
                        ul.list-inline.mb-0
                            li.list-inline-item.me-4
                                a(href='#!')
                                    i.bi-facebook.fs-3
                            li.list-inline-item.me-4
                                a(href='#!')
                                    i.bi-twitter.fs-3
                            li.list-inline-item
                                a(href='#!')
                                    i.bi-instagram.fs-3

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')

        // Core theme JS
        script(src='js/scripts.js')

        // * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
        // * *                               SB Forms JS                               * *
        // * * Activate your form at https://startbootstrap.com/solution/contact-forms * *
        // * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

        script(src='https://cdn.startbootstrap.com/sb-forms-latest.js')